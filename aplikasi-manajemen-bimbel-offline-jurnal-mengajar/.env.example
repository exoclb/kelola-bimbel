# npm run setup creates private local values in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433

# Optional: mark this deployment as a release. Blank means it follows NODE_ENV
# (production = release). Set true to hide the starter showcase pages even in a
# local or review build; set false to keep them reachable in a release build.
MODE_RILIS=

# Optional: the app runs scheduled backups itself (Settings -> Backup) using the
# schedule stored in the database. Set nonaktif/off/false to turn that scheduler
# off, e.g. when an external cron job runs `npm run db:backup` instead. Blank
# means the in-app scheduler stays on.
PENJADWAL_BACKUP=

# Optional: send password reset links through a real SMTP provider. Leave these
# blank and the link is written to the server log instead, so local and test
# flows keep working. SMTP_FROM falls back to SMTP_USER when left blank.
SMTP_HOST=
SMTP_PORT=587
# Force TLS on/off. Blank means it follows the port: 465 uses TLS from the start.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

